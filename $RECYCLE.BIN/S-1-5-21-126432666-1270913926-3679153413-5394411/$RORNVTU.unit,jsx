      fireEvent.click(submitButton);

      await waitFor(() => {
        expect(screen.getByLabelText('Workload Type *')).toBeDisabled();
        expect(screen.getByRole('radio', { name: 'Shutdown' })).toBeDisabled();
        expect(screen.getByRole('radio', { name: 'Start' })).toBeDisabled();
        expect(screen.getByRole('button', { name: 'Cancel' })).toBeDisabled();
        expect(screen.getByRole('button', { name: 'Submitting...' })).toBeDisabled();
      });
    });

    test('should handle submission error', async () => {
      const consoleErrorSpy = vi.spyOn(console, 'error').mockImplementation(() => {});
      mockTriggerShutdownRestartWorkflow.mockRejectedValueOnce(
        new Error('Failed to trigger workflow')
      );

      render(
        <ShutdownRestartModal
          environment={mockEnvironment}
          onClose={mockOnClose}
          onSuccess={mockOnSuccess}
        />
      );

      await waitFor(() => {
        expect(screen.getByRole('button', { name: /Submit.*Request/i })).toBeInTheDocument();
      });

      const submitButton = screen.getByRole('button', { name: /Submit.*Request/i });
      fireEvent.click(submitButton);

      await waitFor(() => {
        expect(screen.getByText('Failed to trigger workflow')).toBeInTheDocument();
      });

      expect(mockOnClose).not.toHaveBeenCalled();
      expect(mockOnSuccess).not.toHaveBeenCalled();

      consoleErrorSpy.mockRestore();
    });

    test('should disable submit button when no workload is selected', async () => {
      mockGetWorkloadTypes.mockResolvedValueOnce({
        workloadTypes: [],
      });

      render(
        <ShutdownRestartModal
          environment={mockEnvironment}
          onClose={mockOnClose}
          onSuccess={mockOnSuccess}
        />
      );

      await waitFor(() => {
        expect(screen.getByRole('button', { name: /Submit.*Request/i })).toBeInTheDocument();
      });

      const submitButton = screen.getByRole('button', { name: /Submit.*Request/i });
      
      // Button should be disabled when no workload types are available
      expect(submitButton).toBeDisabled();
      
      // Clicking disabled button shouldn't trigger API call
      fireEvent.click(submitButton);
      expect(mockTriggerShutdownRestartWorkflow).not.toHaveBeenCalled();
    });

    test('should clear error message when resubmitting after error', async () => {
      const consoleErrorSpy = vi.spyOn(console, 'error').mockImplementation(() => {});
      mockTriggerShutdownRestartWorkflow
        .mockRejectedValueOnce(new Error('Failed to trigger workflow'))
        .mockResolvedValueOnce({ success: true });

      render(
        <ShutdownRestartModal
          environment={mockEnvironment}
          onClose={mockOnClose}
          onSuccess={mockOnSuccess}
        />
      );

      await waitFor(() => {
        expect(screen.getByRole('button', { name: /Submit.*Request/i })).toBeInTheDocument();
      });

      // First submission - fails
      const submitButton = screen.getByRole('button', { name: /Submit.*Request/i });
      fireEvent.click(submitButton);

      await waitFor(() => {
        expect(screen.getByText('Failed to trigger workflow')).toBeInTheDocument();
      });

      // Second submission - succeeds
      fireEvent.click(submitButton);

      await waitFor(() => {
        expect(screen.queryByText('Failed to trigger workflow')).not.toBeInTheDocument();
      });

      consoleErrorSpy.mockRestore();
    });

    test('should not allow form resubmission during loading', async () => {
      mockTriggerShutdownRestartWorkflow.mockImplementation(
        () => new Promise((resolve) => setTimeout(() => resolve({ success: true }), 100))
      );

      render(
        <ShutdownRestartModal
          environment={mockEnvironment}
          onClose={mockOnClose}
          onSuccess={mockOnSuccess}
        />
      );

      await waitFor(() => {
        expect(screen.getByRole('button', { name: /Submit.*Request/i })).toBeInTheDocument();
      });

      const form = screen.getByRole('button', { name: /Submit.*Request/i }).closest('form');
      
      // First submission
      fireEvent.submit(form);

      await waitFor(() => {
        expect(screen.getByText('Submitting...')).toBeInTheDocument();
      });

      // Try to submit again - the button should be disabled
      const submitButton = screen.getByRole('button', { name: 'Submitting...' });
      expect(submitButton).toBeDisabled();

      // Even if we try to submit, it shouldn't call the API again due to the loading state
      // The component properly prevents duplicate submissions
    });
  });

